# Chave da API do Google Gemini. O nivel gratuito atende de sobra este projeto.
# Pegue a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nome do modelo. Nomes de modelo mudam com o tempo: se receber HTTP 404,
# confira na documentacao do provedor qual nome esta valido e troque aqui.
FORGE_MODEL=gemini-3.6-flash
